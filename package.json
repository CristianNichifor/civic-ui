{
  "name": "@cristiannichifor/civic-ui",
  "version": "0.7.0",
  "private": true,
  "description": "Native React controls with opt-in neutral and host-brand themes",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md",
    "COMPONENTS.md",
    "NATIVE.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "RELEASING.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./native.css": "./dist/native.css",
    "./themes/usr.css": "./dist/themes/usr.css",
    "./themes/neutral.css": "./dist/themes/neutral.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "lucide-react": "^1.43.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "lucide-react": "1.43.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.9.2",
    "vite": "7.3.6"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "npm run build",
    "verify": "node verify.mjs",
    "test": "playwright test",
    "test:release": "node --test tests/release.test.mjs",
    "release:assets": "node release-assets.mjs",
    "preview": "vite preview artifacts/react19 --host 127.0.0.1 --port 5221 --strictPort"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16"
  }
}
